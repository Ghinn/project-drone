// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  GUEST
  FARMER
  OPERATOR
  ADMIN
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SysCommand {
  take_picture
  reboot_os
}

model Drone {
  id            String   @id
  name          String?
  macAddress    String?  @unique
  linkFrequency String?
  status        String   @default("offline")
  isApproved    Boolean  @default(false) 
  createdAt     DateTime @default(now())

  // Relasi 1:1 ke User (Operator)
  operator    User[]
  
  // Relasi 1:M ke log telemetri
  telemetryLogs TelemetryLog[]
  predictionAIs PredictionAI[]
  sprays        Spray[]
  sysLogs       SysLog[]
}

model User {
  id            String         @id @default(cuid())
  firebaseUid   String?        @unique
  email         String         @unique
  name          String?
  avatarUrl     String?
  passwordHash  String?

  emailVerified Boolean        @default(false)
  role          Role           @default(GUEST)
  status        ApprovalStatus @default(PENDING)

  // Identifier Drone
  assignedDroneId String?      
  assignedDrone   Drone?       @relation(fields: [assignedDroneId], references: [id])

  lastLoginAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  verificationTokens VerificationToken[]
  sysLogs            SysLog[]

  @@index([role, status])
  @@index([emailVerified])
  @@index([createdAt])
}

model VerificationToken {
  id         String   @id @default(cuid())
  token      String   @unique
  expires    DateTime
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([userId])
}

model TelemetryLog {
  id          Int      @id @default(autoincrement())
  timestamp   DateTime @default(now())

  // Identifier Drone
  droneId     String
  drone       Drone    @relation(fields: [droneId], references: [id], onDelete: Cascade)

  roll        Float
  pitch       Float
  yaw         Float
  altitude    Float
  latitude    Float
  longitude   Float
  groundSpeed Float
  mode        String
  
  battery     Float
  voltage     Float?
  current     Float?

  sys_check   Json?
  rc          Json?

  @@index([droneId, timestamp(sort: Desc)])
}

model PredictionAI {
  id              String   @id @default(cuid())
  snapshotPict    String   // URL atau path gambar
  classification  String   // "sehat" atau "tidak sehat"
  band            Float
  ndvi            Float
  diseaseSeverity Float    // Persentase (misal: 87.5)
  altitudeAI      Float
  latitudeAI      Float
  longitudeAI     Float
  timestamp       DateTime @default(now())

  // Identifier Drone (Best Practice: agar tahu drone mana yang mengambil)
  droneId         String
  drone           Drone    @relation(fields: [droneId], references: [id], onDelete: Cascade)

  @@index([droneId, timestamp(sort: Desc)])
}

model Spray {
  id              String   @id @default(cuid())
  durationSpray   Float    // Detik
  volumeSpray     Float    // ml atau liter
  capacityTank    Float    // Persentase (0 - 100)
  remainingTank   Float    // Persentase (0 - 100)
  timestamp       DateTime @default(now())

  // Identifier Drone
  droneId         String
  drone           Drone    @relation(fields: [droneId], references: [id], onDelete: Cascade)

  @@index([droneId, timestamp(sort: Desc)])
}

model SysLog {
  id              String     @id @default(cuid())
  
  // Relasi User
  userId          String
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role            Role

  // Relasi Drone
  assignedDroneId String
  assignedDrone   Drone      @relation(fields: [assignedDroneId], references: [id], onDelete: Cascade)

  // Command dienkapsulasi menggunakan Enum
  command         SysCommand 
  timestamp       DateTime   @default(now())

  @@index([userId])
  @@index([assignedDroneId, timestamp(sort: Desc)])
}